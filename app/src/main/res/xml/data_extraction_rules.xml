<?xml version="1.0" encoding="utf-8"?>
<!--
   Nothing is backed up or transferred: the app's private files hold the client key the TV
   trusts, and the settings only matter for the TV it is paired with.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
