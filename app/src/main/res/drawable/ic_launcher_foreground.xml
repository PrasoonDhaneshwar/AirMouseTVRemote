<?xml version="1.0" encoding="utf-8"?>
<!-- Icon L3b: a TV with the pointer on its screen, a remote tilted in front of its corner, and two
     waves rising from the remote's tip. The coordinates are the design's own, which keeps the mark
     inside the 66 dp safe circle of the 108 dp canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The TV -->
    <path
        android:fillColor="#2C3038"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:pathData="M33,40 H61 A7,7 0 0 1 68,47 V63 A7,7 0 0 1 61,70 H33 A7,7 0 0 1 26,63 V47 A7,7 0 0 1 33,40 Z" />
    <!-- Its pointer -->
    <path
        android:fillColor="#00C4CC"
        android:strokeColor="#00C4CC"
        android:strokeWidth="2"
        android:strokeLineJoin="round"
        android:pathData="M35.5,46.5 L35.5,64 L40,59.5 L43.2,66.3 L46.4,64.9 L43.2,58.2 L49,58.2 Z" />
    <!-- The remote, filled with the background so it hides the TV's edge behind it -->
    <group
        android:pivotX="72"
        android:pivotY="62"
        android:rotation="12">
        <path
            android:fillColor="#161A1F"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.5"
            android:pathData="M72,47 A7,7 0 0 1 79,54 V70 A7,7 0 0 1 72,77 A7,7 0 0 1 65,70 V54 A7,7 0 0 1 72,47 Z" />
        <path
            android:fillColor="#00C4CC"
            android:pathData="M72,51.2 A3.3,3.3 0 1 1 72,57.8 A3.3,3.3 0 1 1 72,51.2 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M72,61.5 A2,2 0 1 1 72,65.5 A2,2 0 1 1 72,61.5 Z M72,67.5 A2,2 0 1 1 72,71.5 A2,2 0 1 1 72,67.5 Z" />
    </group>
    <!-- Two waves from the tip -->
    <path
        android:strokeColor="#00C4CC"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M72.03,41.27 A6,6 0 0 1 80.33,43.03" />
    <path
        android:strokeColor="#00C4CC"
        android:strokeAlpha="0.6"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M69.58,37.49 A10.5,10.5 0 0 1 84.11,40.58" />
</vector>
