<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The phone acts as a Bluetooth mouse for the TV. From Android 12 these are asked for when
         the user sets the air mouse up; ADVERTISE is what lets the phone be made visible to the TV
         for pairing. Older versions use the install-time pair below. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- Lets the phone look for the TV during setup. Never used to work out where the phone is. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- An app that includes the air mouse still installs on phones without Bluetooth or a gyroscope -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />

</manifest>
